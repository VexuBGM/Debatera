# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk routing (defaults set in layout.tsx)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Stream
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/debatera?schema=public"
# optional
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_BASE_URL=
PORTAL_TOKEN_TTL_DAYS=14

# Optional E2E smoke test settings
# E2E_SEED=1 creates deterministic portal/ballot smoke-test data in DATABASE_URL.
# Use it only with a local/test database. It derives E2E_PORTAL_URL and E2E_BALLOT_URL when omitted.
# When E2E_SEED=1 and no E2E_BASE_URL/E2E_START_SERVER is set, Playwright starts the local dev server.
E2E_BASE_URL=
E2E_START_SERVER=
E2E_SEED=

# Clerk-backed E2E login tests still require a real Clerk test account.
# Emails ending in +clerk_test@gmail.com can use Clerk's test verification code.
E2E_CLERK_EMAIL=test+clerk_test@gmail.com
E2E_CLERK_PASSWORD=
E2E_CLERK_VERIFICATION_CODE=424242

# Optional manual overrides for seeded or pre-existing portal/ballot URLs.
E2E_PORTAL_URL=
E2E_BALLOT_URL=
