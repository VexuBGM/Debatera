generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USER MODEL (Clerk-based auth)
// ============================================================================
model User {
  id        String   @id @db.VarChar(128) // Clerk user ID
  email     String?  @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @deprecated – username is no longer used; kept temporarily for backward compat
  username String?

  // Profile fields (editable by user)
  bio              String?   @db.Text
  pronouns         String?   @db.VarChar(64)
  displayName      String?   @db.VarChar(128)
  publicEmail      Boolean   @default(false)
  updatedProfileAt DateTime?

  // Relationships
  institutionMemberships InstitutionMember[]
  tournamentsCreated     Tournament[]
  tournamentInstitutions TournamentInstitution[]
  tournamentParticipants TournamentParticipant[]
  invitationsReceived    InstitutionInvitation[] @relation("InvitedUser")
  invitationsCreated     InstitutionInvitation[] @relation("InvitationCreator")
  notifications          Notification[]
  teamsCreated           TournamentTeam[]        @relation("TeamsCreated")

  @@index([email])
}

// ============================================================================
// INSTITUTION MODELS
// ============================================================================
model Institution {
  id        String   @id @default(dbgenerated("('inst_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  name      String   @unique
  createdAt DateTime @default(now())

  // Relationships
  members                InstitutionMember[]
  invitations            InstitutionInvitation[]
  tournamentInstitutions TournamentInstitution[]
  tournamentParticipants TournamentParticipant[]
  tournamentTeams        TournamentTeam[]
}

enum InstitutionRole {
  ADMIN
  MEMBER
}

model InstitutionMember {
  id            String          @id @default(dbgenerated("('imem_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  institutionId String          @db.VarChar(128)
  userId        String          @db.VarChar(128)
  role          InstitutionRole @default(MEMBER)
  createdAt     DateTime        @default(now())

  // Relationships
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
}

// ============================================================================
// TOURNAMENT MODELS
// ============================================================================
model Tournament {
  id                   String    @id @default(dbgenerated("('tourn_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  name                 String
  createdByUserId      String    @db.VarChar(128)
  createdAt            DateTime  @default(now())
  registrationClosesAt DateTime?

  // Team size configuration for this tournament
  // DEPRECATED: Moving to TournamentSettings
  teamMinSize Int @default(2)
  teamMaxSize Int @default(5)

  // Relationships
  createdBy              User                    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  settings               TournamentSettings?
  tournamentInstitutions TournamentInstitution[]
  tournamentParticipants TournamentParticipant[]
  tournamentTeams        TournamentTeam[]
  rounds                 TournamentRound[]
  venues                 Venue[]
  venueCategories        VenueCategory[]
  videoCalls             VideoCall[]
  accessLinks            TournamentParticipantAccessLink[]
}

// ============================================================================
// TOURNAMENT SETTINGS
// ============================================================================

enum DebateFormat {
  WSDC
}

enum EventMode {
  ONLINE
  IRL
}

enum PairingSystem {
  SWISS
  RANDOM
  MANUAL
}

model TournamentSettings {
  id                   String        @id @default(cuid())
  tournamentId         String        @unique @db.VarChar(128)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  teamSizeMin          Int           @default(2)
  teamSizeMax          Int           @default(5)
  debateFormat         DebateFormat  @default(WSDC)
  eventMode            EventMode     @default(IRL)
  pairingSystem        PairingSystem @default(SWISS)
  showDebaterNames     Boolean       @default(false)  // When true, display debater names instead of team names
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ============================================================================
// TOURNAMENT REGISTRATION MODELS
// ============================================================================

enum TournamentInstitutionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TournamentParticipantRole {
  DEBATER
  JUDGE
}

model TournamentInstitution {
  id                String                      @id @default(cuid())
  tournamentId      String                      @db.VarChar(128)
  institutionId     String                      @db.VarChar(128)
  status            TournamentInstitutionStatus @default(PENDING)
  requestedByUserId String                      @db.VarChar(128)
  createdAt         DateTime                    @default(now())

  tournament  Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  requestedBy User        @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, institutionId])
  @@index([tournamentId])
  @@index([institutionId])
  @@index([requestedByUserId])
}

model TournamentParticipant {
  id            String                    @id @default(cuid())
  tournamentId  String                    @db.VarChar(128)
  userId        String                    @db.VarChar(128)
  institutionId String                    @db.VarChar(128)
  role          TournamentParticipantRole
  createdAt     DateTime                  @default(now())

  tournament  Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // A participant can be in at most one team per tournament
  teamMembership   TournamentTeamMember?
  judgeAssignments TournamentDebateJudge[]
  accessLink       TournamentParticipantAccessLink?

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@index([institutionId])
}

// ============================================================================
// TOURNAMENT TEAM MODELS
// ============================================================================

// A team within a tournament, created by an institution admin
model TournamentTeam {
  id              String   @id @default(cuid())
  tournamentId    String   @db.VarChar(128)
  institutionId   String   @db.VarChar(128)
  name            String // Auto-generated: "${Institution.name} 1", "${Institution.name} 2", etc.
  createdByUserId String   @db.VarChar(128)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  tournament  Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("TeamsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members     TournamentTeamMember[]
  propDebates TournamentDebate[]     @relation("PropTeam")
  oppDebates  TournamentDebate[]     @relation("OppTeam")
  debateWins  DebateResult[]         @relation("DebateWinner")

  // Team name must be unique within an institution for a given tournament
  @@unique([tournamentId, institutionId, name])
  @@index([tournamentId])
  @@index([institutionId])
  @@index([createdByUserId])
}

// Membership linking a participant to a team
model TournamentTeamMember {
  id            String   @id @default(cuid())
  teamId        String
  participantId String   @unique // A participant can only be in ONE team
  createdAt     DateTime @default(now())

  // Relationships
  team        TournamentTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  ballotSpeeches BallotSpeech[]

  @@index([teamId])
}

// ============================================================================
// TOURNAMENT ROUND & DEBATE MODELS
// ============================================================================

enum TournamentRoundStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
}

// A round within a tournament (e.g., "Round 1", "Quarterfinals")
model TournamentRound {
  id           String                @id @default(cuid())
  tournamentId String                @db.VarChar(128)
  number       Int                   // Sequential round number within tournament
  name         String                // Display name, e.g., "Round 1" or "Quarterfinals"
  motion       String?               // Debate motion / topic for this round
  infoSlide    String?               // Optional context slide shown before the debate
  status       TournamentRoundStatus @default(DRAFT)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  // Relationships
  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  debates    TournamentDebate[]

  @@unique([tournamentId, number])
  @@index([tournamentId])
}

// A single debate (pairing) within a round
// In WSDC format: 2 teams (proposition vs opposition)
model TournamentDebate {
  id         String   @id @default(cuid())
  roundId    String
  order      Int      // For stable UI ordering within the round
  propTeamId String?  @db.VarChar(128) // Nullable only for BYE debates
  oppTeamId  String?  @db.VarChar(128) // Nullable only for BYE debates
  venueId    String?  // Assigned venue (nullable; set by auto-allocator or manually)
  isBye      Boolean  @default(false) // True if this is a bye (one team, no opponent)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  round    TournamentRound          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  propTeam TournamentTeam?          @relation("PropTeam", fields: [propTeamId], references: [id], onDelete: SetNull)
  oppTeam  TournamentTeam?          @relation("OppTeam", fields: [oppTeamId], references: [id], onDelete: SetNull)
  venue    Venue?                   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  judges    TournamentDebateJudge[]
  ballots   Ballot[]
  result    DebateResult?
  videoCall VideoCall?
  stopwatch DebateStopwatch?

  @@unique([roundId, order])
  @@index([roundId])
  @@index([propTeamId])
  @@index([oppTeamId])
  @@index([venueId])
}

// Judge role within a debate panel
enum JudgeRole {
  CHAIR     // Exactly one per debate; casts the tiebreaker vote
  PANELIST  // Zero or more per debate
}

// Junction table for judges assigned to a debate
// Each judge (TournamentParticipant with role=JUDGE) can only be in ONE debate per round
model TournamentDebateJudge {
  id            String    @id @default(cuid())
  debateId      String
  participantId String    // Must be a TournamentParticipant with role=JUDGE
  role          JudgeRole @default(PANELIST)
  createdAt     DateTime  @default(now())

  // Relationships
  debate      TournamentDebate      @relation(fields: [debateId], references: [id], onDelete: Cascade)
  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  ballot      Ballot?

  // A judge can only be assigned to ONE debate per round (enforced via unique constraint)
  // The roundId is derived from debate.roundId in application logic
  @@unique([debateId, participantId]) // Prevent duplicate judge in same debate
  @@index([debateId])
  @@index([participantId])
  @@index([role])
}

// ============================================================================
// VENUE MODELS
// ============================================================================

// A physical venue (room) available for debates in an IRL tournament
model Venue {
  id           String   @id @default(cuid())
  tournamentId String   @db.VarChar(128)
  name         String   // e.g., "Room 101", "Main Hall"
  priority     Int      @default(100) // Higher = better room; used for auto-allocation sorting
  isActive     Boolean  @default(true) // Inactive venues are excluded from auto-allocation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  categories VenueCategory[]     // Implicit M2M with VenueCategory
  debates    TournamentDebate[]

  @@unique([tournamentId, name]) // Venue names must be unique within a tournament
  @@index([tournamentId])
  @@index([priority])
}

// A tag/category for grouping venues (e.g., "Wheelchair Accessible", "Building A")
model VenueCategory {
  id           String   @id @default(cuid())
  tournamentId String   @db.VarChar(128)
  name         String   // e.g., "Wheelchair Accessible", "Building A"
  description  String?  // Optional description for the category
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  venues     Venue[]    // Implicit M2M with Venue

  @@unique([tournamentId, name]) // Category names must be unique within a tournament
  @@index([tournamentId])
}

// ============================================================================
// INVITATION & NOTIFICATION MODELS
// ============================================================================

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model InstitutionInvitation {
  id              String           @id @default(dbgenerated("('inv_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  institutionId   String           @db.VarChar(128)
  invitedUserId   String           @db.VarChar(128)
  createdByUserId String           @db.VarChar(128)
  role            InstitutionRole  @default(MEMBER)
  status          InvitationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  respondedAt     DateTime?

  // Relationships
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedUser User        @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([institutionId, invitedUserId, status], name: "unique_pending_invitation")
  @@index([institutionId])
  @@index([invitedUserId])
  @@index([status])
}

enum NotificationType {
  INSTITUTION_INVITE
  GENERAL
}

model Notification {
  id         String           @id @default(dbgenerated("('notif_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  userId     String           @db.VarChar(128)
  type       NotificationType @default(GENERAL)
  title      String
  message    String?
  entityType String?          @db.VarChar(64) // e.g. "InstitutionInvitation"
  entityId   String?          @db.VarChar(128) // e.g. invitation id
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([entityType, entityId])
}

// ============================================================================
// PARTICIPANT ACCESS LINKS (Judge Portal)
// ============================================================================

// One access link per tournament participant (token-based portal access)
model TournamentParticipantAccessLink {
  id            String    @id @default(cuid())
  tournamentId  String    @db.VarChar(128)
  participantId String    @unique // One link per participant
  tokenHash     String    @unique // SHA-256 hash of the token (never store plaintext)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  // Relationships
  tournament  Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([tokenHash])
}

// ============================================================================
// BALLOT ENUMS
// ============================================================================

enum BallotStatus {
  DRAFT
  SUBMITTED
}

enum Side {
  PROPOSITION
  OPPOSITION
}

enum SpeechRole {
  PROP_1
  OPP_1
  PROP_2
  OPP_2
  PROP_3
  OPP_3
  OPP_REPLY
  PROP_REPLY
}

// ============================================================================
// BALLOT MODELS (WSDC individual adjudicator ballots)
// ============================================================================

// One ballot per adjudicator per debate
model Ballot {
  id              String       @id @default(cuid())
  debateId        String
  adjudicatorId   String       @unique // FK to TournamentDebateJudge (1:1)
  status          BallotStatus @default(DRAFT)
  vote            Side?        // Winning side chosen by this adjudicator
  propTotal       Decimal?     @db.Decimal(5, 1) // Computed server-side
  oppTotal        Decimal?     @db.Decimal(5, 1)
  privateNotes    String?      @db.Text
  submittedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relationships
  debate      TournamentDebate      @relation(fields: [debateId], references: [id], onDelete: Cascade)
  adjudicator TournamentDebateJudge @relation(fields: [adjudicatorId], references: [id], onDelete: Cascade)
  speeches    BallotSpeech[]

  @@unique([debateId, adjudicatorId])
  @@index([debateId])
  @@index([adjudicatorId])
  @@index([status])
}

// Individual speech score within a ballot
model BallotSpeech {
  id          String     @id @default(cuid())
  ballotId    String
  role        SpeechRole
  side        Side       // Derived from role but stored for easier queries
  speakerId   String?    // FK to TournamentTeamMember (optional)
  speakerName String?    // Fallback display name
  score       Decimal?   @db.Decimal(4, 1) // e.g. 75.5
  comment     String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  ballot  Ballot              @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  speaker TournamentTeamMember? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@unique([ballotId, role])
  @@index([ballotId])
  @@index([speakerId])
}

// Stores the computed debate result after all ballots are submitted
model DebateResult {
  id            String   @id @default(cuid())
  debateId      String   @unique
  winningSide   Side
  winningTeamId String?  @db.VarChar(128)
  propTotalAvg  Decimal? @db.Decimal(5, 1) // Average across all ballots
  oppTotalAvg   Decimal? @db.Decimal(5, 1)
  voteProp      Int      @default(0) // Number of votes for proposition
  voteOpp       Int      @default(0) // Number of votes for opposition
  decidedByChair Boolean @default(false) // True if tie broken by chair
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  debate      TournamentDebate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  winningTeam TournamentTeam?  @relation("DebateWinner", fields: [winningTeamId], references: [id], onDelete: SetNull)

  @@index([debateId])
  @@index([winningTeamId])
}

// ============================================================================
// DEBATE STOPWATCH (synced timer for debate calls)
// ============================================================================

model DebateStopwatch {
  id            String   @id @default(cuid())
  debateId      String   @unique @db.VarChar(128) // 1:1 with TournamentDebate
  running       Boolean  @default(false)
  startedAtMs   BigInt?  // Unix ms when last started (server time)
  baseElapsedMs BigInt   @default(0) // Accumulated elapsed while previously running
  version       Int      @default(0) // Monotonic; increments on every state change
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  debate TournamentDebate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([debateId])
}

// ============================================================================
// VIDEO CALL MODELS (Stream / getStream.io)
// ============================================================================

enum VideoCallKind {
  DEBATE
}

model VideoCall {
  id           String        @id @default(cuid())
  kind         VideoCallKind
  tournamentId String        @db.VarChar(128)
  debateId     String?       @unique @db.VarChar(128)
  callType     String        // e.g. "debate"
  callId       String        // e.g. "debate_<debateId>"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  debate     TournamentDebate? @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@unique([kind, debateId])
  @@index([tournamentId, kind])
  @@index([debateId])
}
