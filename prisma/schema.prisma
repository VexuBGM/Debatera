generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USER MODEL (Clerk-based auth)
// ============================================================================
model User {
  id        String   @id @db.VarChar(128) // Clerk user ID
  email     String?  @unique
  username  String?  @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  institutionMemberships InstitutionMember[]
  tournamentsCreated     Tournament[]
  tournamentInstitutions TournamentInstitution[]
  tournamentParticipants TournamentParticipant[]
  invitationsReceived    InstitutionInvitation[] @relation("InvitedUser")
  invitationsCreated     InstitutionInvitation[] @relation("InvitationCreator")
  notifications          Notification[]
  teamsCreated           TournamentTeam[]        @relation("TeamsCreated")

  @@index([email])
  @@index([username])
}

// ============================================================================
// INSTITUTION MODELS
// ============================================================================
model Institution {
  id        String   @id @default(dbgenerated("('inst_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  name      String   @unique
  createdAt DateTime @default(now())

  // Relationships
  members                InstitutionMember[]
  invitations            InstitutionInvitation[]
  tournamentInstitutions TournamentInstitution[]
  tournamentParticipants TournamentParticipant[]
  tournamentTeams        TournamentTeam[]
}

enum InstitutionRole {
  ADMIN
  MEMBER
}

model InstitutionMember {
  id            String          @id @default(dbgenerated("('imem_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  institutionId String          @db.VarChar(128)
  userId        String          @db.VarChar(128)
  role          InstitutionRole @default(MEMBER)
  createdAt     DateTime        @default(now())

  // Relationships
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
}

// ============================================================================
// TOURNAMENT MODELS
// ============================================================================
model Tournament {
  id                   String    @id @default(dbgenerated("('tourn_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  name                 String
  createdByUserId      String    @db.VarChar(128)
  createdAt            DateTime  @default(now())
  registrationClosesAt DateTime?

  // Team size configuration for this tournament
  // DEPRECATED: Moving to TournamentSettings
  teamMinSize Int @default(2)
  teamMaxSize Int @default(5)

  // Relationships
  createdBy              User                    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  settings               TournamentSettings?
  tournamentInstitutions TournamentInstitution[]
  tournamentParticipants TournamentParticipant[]
  tournamentTeams        TournamentTeam[]
}

// ============================================================================
// TOURNAMENT SETTINGS
// ============================================================================

model TournamentSettings {
  id                   String    @id @default(cuid())
  tournamentId         String    @unique @db.VarChar(128)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  teamSizeMin          Int       @default(2)
  teamSizeMax          Int       @default(5)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ============================================================================
// TOURNAMENT REGISTRATION MODELS
// ============================================================================

enum TournamentInstitutionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TournamentParticipantRole {
  DEBATER
  JUDGE
}

model TournamentInstitution {
  id                String                      @id @default(cuid())
  tournamentId      String                      @db.VarChar(128)
  institutionId     String                      @db.VarChar(128)
  status            TournamentInstitutionStatus @default(PENDING)
  requestedByUserId String                      @db.VarChar(128)
  createdAt         DateTime                    @default(now())

  tournament  Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  requestedBy User        @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, institutionId])
  @@index([tournamentId])
  @@index([institutionId])
  @@index([requestedByUserId])
}

model TournamentParticipant {
  id            String                    @id @default(cuid())
  tournamentId  String                    @db.VarChar(128)
  userId        String                    @db.VarChar(128)
  institutionId String                    @db.VarChar(128)
  role          TournamentParticipantRole
  createdAt     DateTime                  @default(now())

  tournament  Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // A participant can be in at most one team per tournament
  teamMembership TournamentTeamMember?

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@index([institutionId])
}

// ============================================================================
// TOURNAMENT TEAM MODELS
// ============================================================================

// A team within a tournament, created by an institution admin
model TournamentTeam {
  id              String   @id @default(cuid())
  tournamentId    String   @db.VarChar(128)
  institutionId   String   @db.VarChar(128)
  name            String // Auto-generated: "${Institution.name} 1", "${Institution.name} 2", etc.
  createdByUserId String   @db.VarChar(128)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  tournament  Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("TeamsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members     TournamentTeamMember[]

  // Team name must be unique within an institution for a given tournament
  @@unique([tournamentId, institutionId, name])
  @@index([tournamentId])
  @@index([institutionId])
  @@index([createdByUserId])
}

// Membership linking a participant to a team
model TournamentTeamMember {
  id            String   @id @default(cuid())
  teamId        String
  participantId String   @unique // A participant can only be in ONE team
  createdAt     DateTime @default(now())

  // Relationships
  team        TournamentTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ============================================================================
// INVITATION & NOTIFICATION MODELS
// ============================================================================

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model InstitutionInvitation {
  id              String           @id @default(dbgenerated("('inv_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  institutionId   String           @db.VarChar(128)
  invitedUserId   String           @db.VarChar(128)
  createdByUserId String           @db.VarChar(128)
  role            InstitutionRole  @default(MEMBER)
  status          InvitationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  respondedAt     DateTime?

  // Relationships
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedUser User        @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([institutionId, invitedUserId, status], name: "unique_pending_invitation")
  @@index([institutionId])
  @@index([invitedUserId])
  @@index([status])
}

enum NotificationType {
  INSTITUTION_INVITE
  GENERAL
}

model Notification {
  id         String           @id @default(dbgenerated("('notif_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  userId     String           @db.VarChar(128)
  type       NotificationType @default(GENERAL)
  title      String
  message    String?
  entityType String?          @db.VarChar(64) // e.g. "InstitutionInvitation"
  entityId   String?          @db.VarChar(128) // e.g. invitation id
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([entityType, entityId])
}
