generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USER MODEL (Clerk-based auth)
// ============================================================================
model User {
  id        String   @id @db.VarChar(128) // Clerk user ID
  email     String?  @unique
  username  String?  @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  institutionMemberships    InstitutionMember[]
  tournamentsCreated        Tournament[]
  feedbackGiven             Feedback[]
  invitationsReceived       InstitutionInvitation[] @relation("InvitedUser")
  invitationsCreated        InstitutionInvitation[] @relation("InvitationCreator")
  notifications             Notification[]

  @@index([email])
  @@index([username])
}

// ============================================================================
// INSTITUTION MODELS
// ============================================================================
model Institution {
  id        String   @id @default(dbgenerated("('inst_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  name      String   @unique
  createdAt DateTime @default(now())

  // Relationships
  members       InstitutionMember[]
  registrations TournamentRegistration[]
  invitations   InstitutionInvitation[]
}

enum InstitutionRole {
  ADMIN
  MEMBER
}

model InstitutionMember {
  id            String          @id @default(dbgenerated("('imem_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  institutionId String          @db.VarChar(128)
  userId        String          @db.VarChar(128)
  role          InstitutionRole @default(MEMBER)
  createdAt     DateTime        @default(now())

  // Relationships
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
}

// ============================================================================
// TOURNAMENT MODELS
// ============================================================================
enum TournamentStatus {
  DRAFT
  PUBLISHED
}

model Tournament {
  id              String           @id @default(dbgenerated("('tourn_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  name            String
  status          TournamentStatus @default(DRAFT)
  createdByUserId String           @db.VarChar(128)
  createdAt       DateTime         @default(now())

  // Relationships
  createdBy     User                     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  registrations TournamentRegistration[]
  rounds        Round[]
}

enum RegistrationStatus {
  PENDING
  APPROVED
}

model TournamentRegistration {
  id            String             @id @default(dbgenerated("('reg_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  tournamentId  String             @db.VarChar(128)
  institutionId String             @db.VarChar(128)
  status        RegistrationStatus @default(APPROVED) // Auto-approve for MVP
  createdAt     DateTime           @default(now())

  // Relationships
  tournament  Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // Match relationships (as AFF or NEG team)
  affMatches Match[] @relation("AffTeam")
  negMatches Match[] @relation("NegTeam")

  @@unique([tournamentId, institutionId])
  @@index([tournamentId])
  @@index([institutionId])
}

// ============================================================================
// ROUND & MATCH MODELS
// ============================================================================
model Round {
  id           String   @id @default(dbgenerated("('rnd_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  tournamentId String   @db.VarChar(128)
  number       Int
  createdAt    DateTime @default(now())

  // Relationships
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@unique([tournamentId, number])
  @@index([tournamentId])
}

model Match {
  id                String   @id @default(dbgenerated("('match_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  roundId           String   @db.VarChar(128)
  affRegistrationId String   @db.VarChar(128)
  negRegistrationId String?  @db.VarChar(128) // Nullable for BYE matches
  createdAt         DateTime @default(now())

  // Relationships
  round           Round                   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  affRegistration TournamentRegistration  @relation("AffTeam", fields: [affRegistrationId], references: [id], onDelete: Cascade)
  negRegistration TournamentRegistration? @relation("NegTeam", fields: [negRegistrationId], references: [id], onDelete: Cascade)
  room            Room?
  feedback        Feedback[]

  @@index([roundId])
  @@index([affRegistrationId])
  @@index([negRegistrationId])
}

// ============================================================================
// ROOM MODEL (Video Call)
// ============================================================================
model Room {
  id           String   @id @default(dbgenerated("('room_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  matchId      String   @unique @db.VarChar(128)
  streamCallId String   @db.VarChar(256) // GetStream call ID
  createdAt    DateTime @default(now())

  // Relationships
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

// ============================================================================
// FEEDBACK MODEL
// ============================================================================
enum FeedbackWinner {
  AFF
  NEG
  NONE
}

model Feedback {
  id          String         @id @default(dbgenerated("('fb_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  matchId     String         @db.VarChar(128)
  judgeUserId String         @db.VarChar(128)
  affFeedback String?
  negFeedback String?
  winner      FeedbackWinner @default(NONE)
  createdAt   DateTime       @default(now())

  // Relationships
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  judge User  @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)

  @@unique([matchId, judgeUserId]) // One feedback per judge per match
  @@index([matchId])
  @@index([judgeUserId])
}

// ============================================================================
// INVITATION & NOTIFICATION MODELS
// ============================================================================

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model InstitutionInvitation {
  id              String           @id @default(dbgenerated("('inv_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  institutionId   String           @db.VarChar(128)
  invitedUserId   String           @db.VarChar(128)
  createdByUserId String           @db.VarChar(128)
  role            InstitutionRole  @default(MEMBER)
  status          InvitationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  respondedAt     DateTime?

  // Relationships
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedUser User        @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([institutionId, invitedUserId, status], name: "unique_pending_invitation")
  @@index([institutionId])
  @@index([invitedUserId])
  @@index([status])
}

enum NotificationType {
  INSTITUTION_INVITE
  GENERAL
}

model Notification {
  id         String           @id @default(dbgenerated("('notif_'::text || (gen_random_uuid())::text)")) @db.VarChar(128)
  userId     String           @db.VarChar(128)
  type       NotificationType @default(GENERAL)
  title      String
  message    String?
  entityType String?          @db.VarChar(64) // e.g. "InstitutionInvitation"
  entityId   String?          @db.VarChar(128) // e.g. invitation id
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([entityType, entityId])
}
